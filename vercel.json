{
  "functions": {
    "api/tasks.js": {
      "maxDuration": 10
    },
    "api/v1/router.js": {
      "maxDuration": 60
    },
    "api/mcp-server.js": {
      "maxDuration": 60
    },
    "api/mcp-v2.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1/router?path=:path*"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/mcp-server"
    },
    {
      "source": "/api/mcp/:path*",
      "destination": "/api/mcp-server?mcpkey=:path*"
    },
    {
      "source": "/api/mcp-v2/:path*",
      "destination": "/api/mcp-v2?mcpkey=:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
