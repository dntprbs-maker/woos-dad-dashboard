# ── Notion 공식 REST API ───────────────────────────────────────────────
# Notion Integration Secret. 코드에 절대 넣지 말고 여기(로컬)와 Vercel 환경변수에만 둔다.
NOTION_TOKEN=ntn_여기에_인테그레이션_시크릿

# 대상 작업 DB. database id 든 data source id 든 코드가 알아서 판별한다.
#   작업·업무협업 : 8ba2d174-b03c-8369-b0a2-07b234b93430
#   📋 작업 관리   : ea385c28-4a44-409b-b36a-11630f125d5b
NOTION_DATA_SOURCE_ID=8ba2d174-b03c-8369-b0a2-07b234b93430

# ── 공용 작업관리 API 자체 인증키 ──────────────────────────────────────
# 16자 이상. 쉼표로 여러 개, "라벨:비밀값" 형태면 로그에 라벨만 남는다.
#   예) chatgpt:AAAA...,claude:BBBB...,code:CCCC...
TASKS_API_KEY=라벨:16자_이상의_랜덤_문자열

# ── 선택 ───────────────────────────────────────────────────────────────
# TASKS_DUP_THRESHOLD=0.6          # 중복 판정 임계값 (0~1)
# TASKS_MAX_SCAN=300               # 유사검색이 훑는 최대 건수
# TASKS_API_BASE_URL=https://woos-dad-dashboard.vercel.app   # openapi.json의 servers
# TASKS_API_ALLOWED_ORIGINS=       # 브라우저에서 직접 부를 때만 (기본: CORS 닫힘)

# ── 기존 대시보드용 ────────────────────────────────────────────────────
NOTION_DATABASE_ID=8ba2d174-b03c-8369-b0a2-07b234b93430
DASHBOARD_PASSWORD=여기에_대시보드_접속_비밀번호

# 노션 운영규칙 페이지 ID (Single Source of Truth). Integration에 연결돼 있어야 한다.
NOTION_RULES_PAGE_ID=3c92d174-b03c-81c3-bff4-c95cb9ef0585

# (선택) 운영규칙 변경에 아빠의 암구호를 요구하려면 설정. 설정하면 AI 혼자서는 못 바꾼다.
# RULES_EDIT_PASSPHRASE=
